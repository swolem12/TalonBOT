# TalonBOT Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED SETTINGS
# ============================================

# Signal Bot Phone Number (with country code, e.g., +1234567890)
SIGNAL_BOT_PHONE_NUMBER=

# Database URL (SQLite by default, can be changed to PostgreSQL)
DATABASE_URL="file:./talonbot.db"

# ============================================
# ADMIN CONFIGURATION
# ============================================

# Comma-separated list of admin phone numbers (with country code)
# These users can use admin commands like !kick, !ban, !mute
ADMIN_USERS=+1234567890,+0987654321

# Master admin phone number (for bot management commands)
MASTER_ADMIN=+1234567890

# ============================================
# SIGNAL-CLI CONFIGURATION
# ============================================

# Path to signal-cli executable (if not in PATH)
# SIGNAL_CLI_PATH=/usr/local/bin/signal-cli

# Signal-cli data directory
# SIGNAL_CLI_DATA_DIR=~/.local/share/signal-cli

# Signal-cli mode: daemon, jsonrpc, or cli
SIGNAL_CLI_MODE=daemon

# JSON-RPC endpoint (if using JSON-RPC mode)
SIGNAL_CLI_JSON_RPC_URL=http://localhost:7583

# ============================================
# BOT BEHAVIOR
# ============================================

# Bot prefix for commands (default: !)
BOT_PREFIX=!

# Enable debug logging
DEBUG=false

# Enable message storage (for reports and analytics)
STORE_MESSAGES=true

# Maximum messages per minute per user (anti-spam)
MAX_MESSAGES_PER_MINUTE=10

# ============================================
# OPTIONAL INTEGRATIONS
# ============================================

# OpenAI API Key (for AI-powered features like summaries)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-3.5-turbo

# Webhook URL for external notifications
# WEBHOOK_URL=https://your-webhook-endpoint.com/notify

# ============================================
# COMMUNITY DASHBOARD INTEGRATION
# ============================================
# See: https://github.com/swolem12/chat-based-community-dashboard

# Enable dashboard integration features
DASHBOARD_INTEGRATION=false

# Dashboard webhook URL for sending notifications to the dashboard
# DASHBOARD_WEBHOOK_URL=http://localhost:3000/api/signal-webhook

# Dashboard API URL for querying dashboard data
# DASHBOARD_API_URL=http://localhost:3000/api

# Dashboard API key (if authentication is enabled)
# DASHBOARD_API_KEY=your-api-key

# ============================================
# MATRIX INTEGRATION (via Dashboard)
# ============================================
# These settings bridge Signal groups with Matrix rooms

# Enable Matrix integration
MATRIX_ACTIVE=false

# Matrix homeserver URL
# MATRIX_HOMESERVER=https://matrix.example.com

# Matrix access token for the bot account
# MATRIX_ACCESS_TOKEN=your_matrix_access_token

# Matrix bot user ID
# MATRIX_USER_ID=@bot:example.com

# Signal bridge room ID (for commands to the Signal bridge bot)
# MATRIX_SIGNAL_BRIDGE_ROOM_ID=!signalbridgeroom:example.com

# ============================================
# HOSTING / DEPLOYMENT
# ============================================

# Server port (if running web dashboard)
PORT=3000

# Node environment
NODE_ENV=development

# Log level: error, warn, info, debug
LOG_LEVEL=info
